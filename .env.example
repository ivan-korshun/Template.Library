Library__ClientCredentials__InternalApi__Audience=https://dependency.dev.ik
Library__ClientCredentials__InternalApi__ClientId=
Library__ClientCredentials__InternalApi__ClientSecret=
Library__ClientCredentials__InternalApi__TokenEndpoint=https://dev-ik.eu.auth0.com/oauth/token
Library__CORS__Default__AllowedOrigins="https://*.test.one, https://test.two"
Library__CORS__Default__AllowedMethods="GET, POST, PATCH, DELETE"
Library__CORS__Default__AllowedHeaders="authorization, content-type, content-language, accept, accept-language"
Library__DB__ConnectionString="Data Source=mssql;Initial Catalog=LibraryDB;User ID=library_db_consumer;Password=db-consumer-password-12345;Encrypt=False"
