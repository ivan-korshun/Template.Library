NLog__rules__0__writeTo="textConsole,logFile"
NLog__targets__logFile__filename="/logs/library-api-$${shortdate}.log"
NLog__targets__logFile__layout="$${longdate} |$${pad:padding=5:inner=$${level:uppercase=true}} | $${logger} | $${message} $${exception:format=tostring,data} | $${aspnet-request-method} $${aspnet-request-url} $${aspnet-request-querystring}"
NLog__targets__logFile__type=File
NLog__targets__textConsole__type=Console
NLog__targets__textConsole__layout="$${longdate} |$${pad:padding=5:inner=$${level:uppercase=true}} | $${logger} | $${message} $${exception:format=tostring,data} | $${aspnet-request-method} $${aspnet-request-url} $${aspnet-request-querystring}"
TAG=1.0.0-0.xxx
