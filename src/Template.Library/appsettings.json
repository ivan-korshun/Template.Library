{
  "AllowedHosts": "*",
  "Library": {
    "ClientCredentials": {
      "InternalApi": {
        "Audience": "",
        "ClientId": "",
        "ClientSecret": "",
        "TokenEndpoint": ""
      }
    },
    "CORS": {},
    "DB": {
      "ConnectionString": ""
    },
    "HealthChecks": {
      "CachedResultExpiration": "00:00:25",
      "HealthEndpoint": "api/status/healthz",
      "LivenessEndpoint": "api/status/healthz/live",
      "ReadinessEndpoint": "api/status/healthz/ready",
      "StartedEndpoint": "api/status/healthz/started",
      "Tags": [ "auth", "credentials", "db", "org-service" ]
    },
    "JwtBearer": {
      "Authority": "",
      "ValidAudiences": ""
    },
    "Metrics": {
      "ExporterEndpoint": "/api/v2.0/prometheus",
      "ExporterPort": 9090
    },
    "OpenApi": {
      "Enabled": true,
      "UiEnabled": false
    },
    "OrganizationService": {
      "ClientCredentials": "InternalApi",
      "Host": ""
    },
    "Resilience": {
      "Default": {
        "AttemptTimeout": { "Timeout": "00:00:15" },
        "CircuitBreaker": {
          "BreakDuration": "00:00:15",
          "FailureRatio": 1,
          "MinimumThroughput": 20,
          "SamplingDuration": "00:00:30"
        },
        "Retry": {
          "BackoffType": "Linear",
          "Delay": "00:00:01",
          "MaxRetryAttempts": 10,
          "UseJitter": true
        },
        "TotalRequestTimeout": { "Timeout": "00:01:40" }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "NLog": {
    "throwConfigExceptions": true,
    "extensions": [
      {
        "assembly": "Elastic.CommonSchema.NLog"
      }
    ],
    "targets": {
      "jsonConsole": {
        "type": "Console",
        "layout": {
          "type": "EcsLayout",
          "metadata": [
            {
              "name": "Method",
              "layout": "${aspnet-request-method}"
            },
            {
              "name": "Url",
              "layout": "${aspnet-request-url}"
            },
            {
              "name": "QueryString",
              "layout": "${aspnet-request-querystring}"
            },
            {
              "name": "UserAgent",
              "layout": "${aspnet-request-useragent}"
            },
            {
              "name": "ClientId",
              "layout": "${aspnet-user-claim:ClaimType=azp}"
            }
          ]
        }
      }
    },
    "rules": [
      {
        "logger": "*",
        "writeTo": "jsonConsole"
      }
    ]
  }
}
