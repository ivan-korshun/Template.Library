{
  "Library": {
    "ClientCredentials": {
      "InternalApi": {
        "Audience": "https://dependency.dev.ik",
        "TokenEndpoint": "https://dev-ik.eu.auth0.com/oauth/token"
      }
    },
    "CORS": {
      "Default": {
        "AllowedOrigins": "https://*.test.one, https://test.two",
        "AllowedMethods": "GET, POST, PATCH, DELETE",
        "AllowedHeaders": "authorization, content-type, content-language, accept, accept-language"
      }
    },
    "DB": {
      "ConnectionString": "TrustServerCertificate=True;Server=localhost;Database=LibraryDB;User Id=sa;Password=Password12345;Encrypt=True;Connection Timeout=30;ConnectRetryCount=3;ConnectRetryInterval=5;Persist Security Info=False;MultipleActiveResultSets=False;Pooling=True;Min Pool Size=5;Max Pool Size=100;"
    },
    "JwtBearer": {
      "Authority": "https://dev-ik.eu.auth0.com/",
      "Audiences": "https://library.dev.ik, https://try.me"
    },
    "Metrics": {
      "ExporterPort": 9098
    },
    "OpenApi": {
      "UiEnabled": true
    },
    "OrganizationService": {
      "Host": "http://org-api:5249"
    }
  },
  "Logging": {
    "LogLevel": {
      "Template.Library.DataSource.Dapper.SqlCommandLoggingObserver": "Debug"
    }
  },
  "NLog": {
    "autoReload": true,
    "targets": {
      "logFile": {
        "type": "File",
        "fileName": "${basedir}/logs/library-api-${shortdate}.log",
        "layout": {
          "type": "EcsLayout",
          "metadata": [
            {
              "name": "Method",
              "layout": "${aspnet-request-method}"
            },
            {
              "name": "Url",
              "layout": "${aspnet-request-url}"
            },
            {
              "name": "QueryString",
              "layout": "${aspnet-request-querystring}"
            },
            {
              "name": "UserAgent",
              "layout": "${aspnet-request-useragent}"
            },
            {
              "name": "ClientId",
              "layout": "${aspnet-user-claim:ClaimType=azp}"
            }
          ]
        }
      },
      "textConsole": {
        "type": "Console",
        "layout": "${longdate} |${pad:padding=5:inner=${level:uppercase=true}} | ${logger} | ${message} ${exception:format=tostring,data} | ${aspnet-request-method} ${aspnet-request-url} ${aspnet-request-querystring}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "writeTo": "textConsole,logFile"
      }
    ]
  }
}
